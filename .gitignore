authnull-service.exe
*.exe
srv.out.log
srv.err.log
so.log
se.log
*.json.tmp
_sources/

# Vendor — use go mod vendor locally, don't commit
vendor/

# Build artifacts.
#
# ROOT-ANCHORED with a leading slash, both of them. A gitignore pattern containing no slash
# matches at ANY depth, so a bare "authnull-service" also matched the directory
# cmd/authnull-service/ -- which silently excluded every NEW file added there from `git add -A`
# while leaving the already-tracked ones alone. The result was a commit whose main.go called
# verifySchema() without the file that defines it, and a build that only failed in CI.
/main
/authnull-service

# Runtime output — the app writes a dated file per day, so these accumulate
# forever in anyone's working tree and conflict on every pull.
logs/
*.log

# Generated by scripts/routedump — regenerate it, don't review it.
routes_output.json

# Local-only: contains real secrets — do NOT commit
api-tests.http
env_ex_local_win.ps1
env_local_win.ps1
env_onprem_win.ps1
env
env.prod

API-INVENTORY.md
API-Test-Report.xlsx
# LibreOffice lock files
.~lock.*#

# Service-account credentials, mounted into the container at runtime. NEVER commit these:
# a Firebase key grants send-to-any-device on the whole project and cannot be scoped down.
secrets/
*-service-account.json
