# =============================================================================
#  CUSTOMER: fill ONLY these, then run the stack. Everything else is preset.
# =============================================================================
#   1. DB user      -> DB_USER  and  POSTGRES_USER     (must be identical)
#   2. DB password  -> DB_PASSWORD and POSTGRES_PASSWORD (must be identical)
#   3. Access mode  -> pick ONE of the two blocks below (domain OR bare IP)
#
#  These are the credentials for the bundled PostgreSQL that the stack creates
#  and connects to. Pick any user/password; the DB_/POSTGRES_ fields must match.
#  URLs: no trailing slash.
# =============================================================================

# ======================
# DATABASE   (<-- CUSTOMER: set DB_USER / DB_PASSWORD, keep the rest)
# ======================
DB_HOST=postgres
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=authnull_db
DB_SCHEMA=did

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=authnull_db
POSTGRES_USER=
POSTGRES_PASSWORD=

# ======================
# ONPREM UI CONFIG   (<-- CUSTOMER: uncomment ONE block, A or B)
# ======================
TENANT_ID=1
ORG_NAME=
WEBAUTHN_RP_NAME=AuthNull

# What each URL is used for:
#   SYSTEM_URL         how browsers, agents and the wallet app reach this VM
#   SSC_SIGNIN_URL     where the admin UI sends an unauthenticated user. Must not
#                      be empty, or /tenant/login reloads forever.
#   SSC_BASE_URL       base the backend prepends "/ssc/signin" to after SAML login
#   CLIENT_URL         admin UI root for emailed links and /org/verify-email
#   TENANT_BASE_DOMAIN tenant sites are default.<org>.<this>; must match nginx/DNS
#   WEBAUTHN_*         passkeys. RP_ID must be a domain; origins are comma-separated

# ---------------------------------------------------------------------------
# A) DOMAIN + HTTPS   (use with nginx/nginx.conf; needs DNS + certificates)
#    Replace example.com with your domain and <org> with ORG_NAME.
# ---------------------------------------------------------------------------
# SYSTEM_URL=https://onprem.example.com
# SYSTEM_IP=<vm-ip>
# DOMAIN_URL=default.<org>.example.com
# SSC_SIGNIN_URL=https://onprem.example.com/ssc/signin
# SSC_BASE_URL=https://onprem.example.com
# CLIENT_URL=https://onprem.example.com
# TENANT_BASE_DOMAIN=example.com
# WEBAUTHN_RP_ID=example.com
# WEBAUTHN_ORIGIN=https://onprem.example.com,https://default.<org>.example.com
# ROOT_URL=https://onprem.example.com
# SSC_URL=https://onprem.example.com/ssc/signin
# AUTHNULL_LOGOUT_URL=https://onprem.example.com/ssc/signin

# ---------------------------------------------------------------------------
# B) BARE IP + HTTP   (use with nginx/nginx-ip.conf; no DNS, no certificate)
#    Replace <vm-ip> with the VM's IP. Passkeys and the default.<org> tenant
#    site do not work on a bare IP; wallet push and TOTP MFA do.
#    DOMAIN_URL is a tenant ID, not an address: the backend takes the 2nd
#    dot-separated label as the org database name, so it must be
#    default.<org>.<vm-ip>. Browsers still open http://<vm-ip>.
# ---------------------------------------------------------------------------
# SYSTEM_URL=http://<vm-ip>
# SYSTEM_IP=<vm-ip>
# DOMAIN_URL=default.<org>.<vm-ip>
# SSC_SIGNIN_URL=http://<vm-ip>/ssc/signin
# SSC_BASE_URL=http://<vm-ip>
# CLIENT_URL=http://<vm-ip>
# TENANT_BASE_DOMAIN=<vm-ip>
# WEBAUTHN_RP_ID=<vm-ip>
# WEBAUTHN_ORIGIN=http://<vm-ip>
# ROOT_URL=http://<vm-ip>
# SSC_URL=http://<vm-ip>/ssc/signin
# AUTHNULL_LOGOUT_URL=http://<vm-ip>/ssc/signin

# ======================
# PER-INSTALL SECRETS   (<-- CUSTOMER: generate each with  openssl rand -hex 32)
# ======================
# Required. Empty JWT_SECRET signs login tokens with a blank key; empty
# INTERNAL_API_KEY breaks policy lookup and audit between services.
JWT_SECRET=
INTERNAL_API_KEY=
GIN_MODE=release

# =============================================================================
#  PRESET BY AUTHNULL — do not change unless instructed
# =============================================================================

# ======================
# REDIS
# ======================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ======================
# SMTP (AuthNull shared relay — sends verification / wallet emails)
# ======================
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
SMTP_PASSWORD=

# ======================
# ENCRYPTION KEYS
# ======================
# Both encrypt data at rest. Do NOT change once the stack has run: changing a key
# does not fail loudly -- it silently makes existing data unreadable (and the TOTP
# key locks every user out of MFA). Keep a backup of this file.
# ENCRYPTION_KEY:      32 hex chars  (openssl rand -hex 16)
# TOTP_ENCRYPTION_KEY: 64 hex chars  (openssl rand -hex 32)
ENCRYPTION_KEY=
TOTP_ENCRYPTION_KEY=

# ======================
# HOST PORT OVERRIDES
# ======================
# 9090 is used by cockpit on many RHEL/Debian installs -- change if it collides.
PAM_HOST_PORT=9090

COMPOSE_PROJECT_NAME=onprem

# =============================================================================
# OKTA SSO (OPTIONAL) — only if you run:  docker compose --profile okta up -d
# Values come from YOUR Okta tenant (Applications -> SAML app -> Sign On).
# =============================================================================
OKTA_LOGIN_ROOT_URL=https://www.okta.com/exkd34w6nxTiIRwaW5d7
OKTA_LOGIN_IDP_METADATA_URL=https://dev-10065336.okta.com/app/exkd34w6nxTiIRwaW5d7/sso/saml/metadata
BLOCKCHAIN_OKTA_APP_SSO_URL=

# =============================================================================
# OPTIONAL INTEGRATIONS (leave blank to disable)
# =============================================================================
# MinIO (object storage; pam-service can use LOCAL_STORAGE_ENABLED instead)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BROWSER_REDIRECT_URL=
# AI / risk
AI_SERVICE_API_KEY=
AIPOLICY_API_KEY=
AZURE_OPENAI_API_KEY=
# Misc
LOCAL_PASSWORD=
IPINFO_TOKEN=
GIT_TOKEN=
# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=
# Cloudflare
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_AUTH_KEY=
CLOUDFLARE_AUTH_EMAIL=
# Azure blob
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
# Ethereum RPC for verifier-service (on-chain lookups)
ALCHEMY_API_KEY=
# Google Cloud bucket for pam-service session recordings
GCLOUD_BUCKET_NAME=
# Kafka audit-log sink for authn-service
KAFKA_BROKERS=
KAFKA_TOPIC=

# =============================================================================
# ADVANCED (OPTIONAL) — read by docker-compose.yml; blank = service default.
# Listed so `docker compose` does not warn "variable is not set".
# =============================================================================
ENV=
API_BASE_URL=
TRUSTED_PROXIES=
DB_MAX_OPEN_CONNS=
DB_MAX_IDLE_CONNS=
AUTHNZ_TIMEOUT_SEC=
LOGGING_URL=
VAULT_SERVICE_URL=
TENANT_SERVICE_URL=
SSO_VERIFICATION_URL=
INSTALL_SCRIPT_URL=
AUTHNULL_UPLINK_URL=
ETHEREUM_URL=
AZURE_CONTAINER_NAME=
SMTP_BCC=
TWILIO_FROM_NUMBER=
ORG_DISCOVERY_ENABLED=
WALLET_ONBOARDING_REQUIRED=
# MFA provider / mobile app
MFA_PROVIDER=
APP_IOS_URL=
APP_ANDROID_URL=
EXPO_ACCESS_TOKEN=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
# MFA push tuning
MFA_PUSH_CHALLENGE_TTL_SEC=
MFA_PUSH_ALLOW_UNSIGNED=
MFA_PUSH_SWEEP_ENABLED=
MFA_PUSH_ACTIVITY_RETENTION_DAYS=
MFA_PUSH_RISK_ENABLED=
MFA_PUSH_RISK_LOOKBACK_DAYS=
MFA_PUSH_ALERT_TO=
MFA_PUSH_ALERT_COOLDOWN_MIN=
MFA_GEOIP_MODE=
MFA_GEOIP_API_URL=
MFA_GEOIP_TIMEOUT_MS=
# Duo
DUO_IKEY=
DUO_SKEY=
DUO_HOST=
# Okta API
OKTA_DOMAIN=
OKTA_API_TOKEN=
OKTA_IDP_METADATA_URL=
